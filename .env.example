# Panel -> your Application -> Developer -> API keys.

# Server-only. Grants full API access for this Application, so it must never
# reach the browser and never be committed.
REKEY_SECRET=rp_test_replace_me
REKEY_URL=https://api.rekey.dev

# Safe in the browser. It identifies the Application; it does not grant
# anything on its own.
NEXT_PUBLIC_REKEY_PUBLIC_KEY=rp_pub_replace_me
NEXT_PUBLIC_REKEY_URL=https://api.rekey.dev

# Where this app is reachable. Checkout sends the buyer back here after paying.
#
# APP_URL is read at request time and is the one that matters in production:
# NEXT_PUBLIC_* is substituted into the bundle at build, so an image built in CI
# without it keeps localhost forever and every buyer is returned to a dead
# address. Set APP_URL wherever you deploy.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Only set this if you serve the app over plain HTTP on a hostname that is not
# localhost (a LAN box, a staging host behind a proxy that does not set
# X-Forwarded-Proto). Otherwise the session cookie is issued with `Secure`, the
# browser refuses it, and sign-in appears to succeed while nobody is ever
# signed in. Leave it unset in production.
# REKEY_COOKIE_SECURE=false
