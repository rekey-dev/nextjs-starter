# Panel -> your Application -> Developer -> API keys.

# Server-only. Grants full API access for this Application, so it must never
# reach the browser and never be committed.
REKEY_SECRET=rp_live_replace_me
REKEY_URL=https://api.rekey.dev

# Safe in the browser. It identifies the Application; it does not grant
# anything on its own.
NEXT_PUBLIC_REKEY_PUBLIC_KEY=rp_pub_replace_me
NEXT_PUBLIC_REKEY_URL=https://api.rekey.dev

# Where this app is reachable. Checkout sends the user back here after paying,
# so it has to be the real origin in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
